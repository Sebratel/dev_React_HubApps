# ============================================================
# SEBRATEL HUB REACT — Staging Environment
# ============================================================
# Copy this file to .env.staging.local and fill in the values.
# .env.staging.local is gitignored — NEVER commit real values.
# ADR-0001-D8: all VITE_* vars are PUBLIC Firebase config only.
#
# To run the staging build locally:
#   npm run dev -- --mode staging
#   npm run build -- --mode staging
#
# FORBIDDEN (ADR-0001-D7 + D8) — belongs in Secret Manager only:
#   VITE_JWT_SECRET / VITE_PRIVATE_KEY / VITE_SERVICE_ACCOUNT_KEY
# ============================================================

# ─── Firebase staging project: hub-apps-staging ─────────────
VITE_FIREBASE_API_KEY=AIzaSyDg04FCrIavT-CmTj670XzDN0YgO9GMuZY
VITE_FIREBASE_AUTH_DOMAIN=hub-apps-staging.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=hub-apps-staging
VITE_FIREBASE_STORAGE_BUCKET=hub-apps-staging.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=128380812490
VITE_FIREBASE_APP_ID=1:128380812490:web:291d06342ab0238ee40833
VITE_FIREBASE_DATABASE_URL=https://hub-apps-staging-default-rtdb.firebaseio.com
VITE_FIREBASE_MEASUREMENT_ID=G-D5QTZF7VJR

# ─── App Check — reCAPTCHA v3 (STAGING site key) ────────────
# Registrar em: https://www.google.com/recaptcha/admin
# Domínio autorizado: hub-apps-staging.web.app + localhost
VITE_RECAPTCHA_V3_SITE_KEY=

# ─── Firebase Cloud Messaging — VAPID public key (opcional) ─
VITE_FCM_VAPID_KEY=

# ─── hub-api ─────────────────────────────────────────────────
VITE_API_URL=https://hub-api.sebratel.com.br

# ─── Staging-only toggles ────────────────────────────────────
# true = aponta para emulators locais (portas padrão)
VITE_USE_EMULATOR=false
