# ============================================================
# Sebratel Hub — Stack ÚNICA para Portainer (hub-web + hub-api)
# ============================================================
# Este arquivo é a ÚNICA fonte de variáveis da stack. Ele cobre
# o FRONTEND (build args VITE_*) e o BACKEND (runtime) de uma vez.
#
# Como usar no Portainer:
#   1. Stacks → Add stack → Build method: Repository (Git) ou Web editor
#   2. Aponte o compose para ./docker-compose.yml (raiz do repo)
#   3. Em "Environment variables" → "Advanced mode" → cole TODO este
#      bloco (já preenchido com os valores reais), OU
#   4. Copie este arquivo para ./.env na raiz antes do deploy.
#
# IMPORTANTE:
#   - As VITE_* são lidas em BUILD TIME (build args do hub-web).
#   - As demais são lidas em RUNTIME pelo hub-api.
#   - Tudo precisa estar AQUI, num lugar só — o Portainer/Compose
#     resolve os ${...} do compose a partir deste único conjunto.
#   - NUNCA commitar este arquivo com valores reais (copiar p/ .env).
# ============================================================


# ════════════════════════════════════════════════════════════
# FRONTEND — hub-web (build args, VITE_*)
# ADR-0001-D8: todas as VITE_* são config PÚBLICA do Firebase.
# ════════════════════════════════════════════════════════════

# ─── Firebase Web config (projeto hub-apps-staging) ─────────
VITE_FIREBASE_API_KEY=AIzaSyDg04FCrIavT-CmTj670XzDN0YgO9GMuZY
VITE_FIREBASE_AUTH_DOMAIN=hub-apps-staging.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=hub-apps-staging
VITE_FIREBASE_STORAGE_BUCKET=hub-apps-staging.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=128380812490
VITE_FIREBASE_APP_ID=1:128380812490:web:291d06342ab0238ee40833
VITE_FIREBASE_DATABASE_URL=https://hub-apps-staging-default-rtdb.firebaseio.com
VITE_FIREBASE_MEASUREMENT_ID=G-D5QTZF7VJR

# ─── App Check / FCM (opcionais — deixar vazio se não usar) ──
VITE_RECAPTCHA_V3_SITE_KEY=
VITE_FCM_VAPID_KEY=

# ─── URL pública do hub-api (consumida pelo frontend) ───────
VITE_API_URL=https://hub-api.sebratel.com.br

# ─── Toggles de build ───────────────────────────────────────
VITE_USE_EMULATOR=false
VITE_SKIP_APP_CHECK=false


# ════════════════════════════════════════════════════════════
# BACKEND — hub-api (runtime)
# ════════════════════════════════════════════════════════════

PORT=3000

# ─── MySQL ───────────────────────────────────────────────────
DB_HOST=10.0.11.171
DB_PORT=3306
DB_NAME=DB_Hub_Apps
DB_USER=DevSebratel
DB_PASS=<senha-do-banco>

# ─── Firebase Admin SDK ──────────────────────────────────────
FIREBASE_PROJECT_ID=hub-apps-staging

# Service Account em base64 (recomendado p/ Portainer — sem volume).
# Gerar com:  base64 -w 0 firebase-service-account.json
# (o hub-api aceita base64 OU JSON puro nesta variável)
FIREBASE_SERVICE_ACCOUNT_JSON=<conteudo-base64-do-service-account>

# ─── SSO JWT (HS256, mín. 32 chars) ─────────────────────────
# Gerar com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SSO_JWT_SECRET=<chave-secreta-hs256>

# ─── CORS — incluir AMBOS os domínios do Firebase Hosting ───
ALLOWED_ORIGINS=https://hub-apps-staging.web.app,https://hub-apps-staging.firebaseapp.com,http://localhost:5173
