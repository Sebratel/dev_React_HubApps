PORT=3000

# MySQL
DB_HOST=
DB_PORT=3306
DB_NAME=DB_Hub_Apps
DB_USER=
DB_PASS=

# Firebase Admin SDK
# Baixar em: Firebase Console → Project Settings → Service Accounts → Generate new private key
# Salvar como firebase-service-account.json na raiz do projeto (gitignored)
FIREBASE_PROJECT_ID=

# CORS — origens permitidas (separadas por vírgula)
ALLOWED_ORIGINS=https://hub-apps-staging.web.app,http://localhost:5173

# Caminho absoluto do firebase-service-account.json NO SERVIDOR
# Necessário apenas no Portainer (deploy via Git — o arquivo não está no repo)
# Exemplo: /opt/hub-api/firebase-service-account.json
# Em dev local (arquivo na raiz do projeto), deixar vazio ou omitir
FIREBASE_SA_PATH=
