PORT=3000

# MySQL
DB_HOST=
DB_PORT=3306
DB_NAME=DB_Hub_Apps
DB_USER=
DB_PASS=

# Firebase Admin SDK
# Baixar em: Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=

# Conteúdo do firebase-service-account.json em base64 (recomendado para Portainer/CI)
# Gerar com: base64 -w 0 firebase-service-account.json
# Em dev local, deixar vazio e manter o arquivo firebase-service-account.json na raiz
FIREBASE_SERVICE_ACCOUNT_JSON=

# CORS — origens permitidas (separadas por vírgula)
ALLOWED_ORIGINS=https://hub-apps-staging.web.app,https://hub-apps-staging.firebaseapp.com,http://localhost:5173
