PORT=3000

# MySQL
DB_HOST=
DB_PORT=3306
DB_NAME=DB_Hub_Apps
DB_USER=
DB_PASS=

# Firebase Admin SDK
# Baixar em: Firebase Console → Project Settings → Service Accounts → Generate new private key
# Salvar como firebase-service-account.json na raiz do projeto (gitignored)
FIREBASE_PROJECT_ID=

# CORS — origens permitidas (separadas por vírgula)
ALLOWED_ORIGINS=https://hub-apps-staging.web.app,http://localhost:5173
