# ============================================================
# hub-api — Environment Variables para Portainer Stack
# ============================================================
# Configurar em: Portainer → Stacks → hub-api → Environment variables
# (ou colar como bloco no campo "Advanced mode" do Stack editor)
#
# NUNCA commitar este arquivo com valores reais.
# Arquivo de referência — copiar e preencher os campos <...>
# ============================================================

PORT=3000

# ─── MySQL ───────────────────────────────────────────────────
DB_HOST=10.0.11.171
DB_PORT=3306
DB_NAME=DB_Hub_Apps
DB_USER=DevSebratel
DB_PASS=<senha-do-banco>

# ─── Firebase Admin SDK ──────────────────────────────────────
FIREBASE_PROJECT_ID=hub-apps-staging

# ─── SSO JWT ─────────────────────────────────────────────────
# Gerar com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SSO_JWT_SECRET=<chave-secreta-hs256-min-32-chars>

# ─── CORS ────────────────────────────────────────────────────
# Firebase Hosting serve em DOIS domínios — incluir ambos obrigatoriamente
ALLOWED_ORIGINS=https://hub-apps-staging.web.app,https://hub-apps-staging.firebaseapp.com,http://localhost:5173

# ─── Service Account (montagem de volume no docker-compose) ──
# Antes do deploy, copiar o arquivo para o servidor:
#   scp hub-api/firebase-service-account.json user@<servidor>:/opt/hub-api/
# Em seguida definir o caminho absoluto aqui:
FIREBASE_SA_PATH=/opt/hub-api/firebase-service-account.json
