# ============================================================
# SEBRATEL HUB REACT — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in the values.
# .env.local is gitignored — NEVER commit real credentials.
#
# ADR-0001-D8: All variables here are PUBLIC Firebase config.
# Public = designed by Firebase to be client-facing.
# See: https://firebase.google.com/docs/web/setup#config-object
#
# FORBIDDEN (ADR-0001-D7 + D8):
#   - VITE_JWT_SECRET          ← never
#   - VITE_PRIVATE_KEY         ← never
#   - VITE_SERVICE_ACCOUNT_KEY ← never
#   - VITE_APP_SECRET          ← never
#   Secrets belong in Firebase Secret Manager + Cloud Functions.
# ============================================================

# Firebase public config (staging project — see ADR-0001-D2)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_URL=

# Firebase App Check — reCAPTCHA v3 site key (public, see Google reCAPTCHA docs)
VITE_RECAPTCHA_V3_SITE_KEY=

# Firebase Cloud Messaging — VAPID public key (public, for web push)
VITE_FCM_VAPID_KEY=
