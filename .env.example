# ============================================================
# Sebratel Hub — .env ÚNICO (template) — frontend + backend
# ============================================================
# UM só arquivo serve tudo: o Vite lê as VITE_*, o hub-api lê o resto.
#
# Dev local:
#   cp .env.example .env      (e preencha DB_PASS / SSO_JWT_SECRET)
#
# Deploy (Portainer):
#   Cole este bloco preenchido em Stacks → Environment variables →
#   Advanced mode, OU copie para ./.env na raiz antes do deploy.
#   Lembre: VITE_* são lidas em BUILD TIME (rebuild do hub-web ao mudar).
#
# .env é gitignored — NUNCA commitar valores reais.
# ADR-0001-D7/D8: as VITE_* são config PÚBLICA do Firebase (não segredos).
# ============================================================


# ════════════════════════════════════════════════════════════
# FRONTEND (Vite)
# ════════════════════════════════════════════════════════════

# ─── Firebase (config pública do projeto hub-apps-staging) ──
VITE_FIREBASE_API_KEY=AIzaSyDg04FCrIavT-CmTj670XzDN0YgO9GMuZY
VITE_FIREBASE_AUTH_DOMAIN=hub-apps-staging.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=hub-apps-staging
VITE_FIREBASE_STORAGE_BUCKET=hub-apps-staging.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=128380812490
VITE_FIREBASE_APP_ID=1:128380812490:web:291d06342ab0238ee40833
VITE_FIREBASE_DATABASE_URL=https://hub-apps-staging-default-rtdb.firebaseio.com

# ─── App Check (reCAPTCHA v3) — vazio usa a key padrão do código ─
VITE_RECAPTCHA_V3_SITE_KEY=
# Opcional: VITE_SKIP_APP_CHECK=true desativa o App Check (somente dev)

# ─── hub-api — URL consumida pelo frontend ──────────────────
# Dev local = http://localhost:3000 | Deploy = https://hub-api.sebratel.com.br
VITE_API_URL=http://localhost:3000


# ════════════════════════════════════════════════════════════
# BACKEND (hub-api)
# ════════════════════════════════════════════════════════════
PORT=3000

# ─── MySQL ───────────────────────────────────────────────────
DB_HOST=10.0.11.171
DB_PORT=3306
DB_NAME=DB_Hub_Apps
DB_USER=DevSebratel
DB_PASS=<senha-do-banco>

# ─── Firebase Admin SDK ──────────────────────────────────────
# Local: deixe FIREBASE_SERVICE_ACCOUNT_JSON vazio (usa o arquivo
# hub-api/firebase-service-account.json). No Portainer: base64 do JSON.
#   base64 -w 0 hub-api/firebase-service-account.json
FIREBASE_PROJECT_ID=hub-apps-staging
FIREBASE_SERVICE_ACCOUNT_JSON=<conteudo-base64-do-service-account>

# ─── SSO JWT (HS256, mín. 32 chars) ─────────────────────────
# Gerar com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SSO_JWT_SECRET=<chave-secreta-hs256>

# ─── CORS — incluir AMBOS os domínios do Firebase Hosting ───
ALLOWED_ORIGINS=https://hub-apps-staging.web.app,https://hub-apps-staging.firebaseapp.com,http://localhost:5173
