# ============================================================
# SEBRATEL HUB — Frontend (dev local) — Variáveis de ambiente
# ============================================================
# Uso:  cp .env.example .env.local   (e ajuste a VITE_API_URL)
# .env.local é gitignored — NUNCA commitar credenciais reais.
#
# ADR-0001-D8: TODAS as VITE_* são config PÚBLICA do Firebase
# (identificadores de projeto, não segredos). Os valores abaixo
# já são os do projeto hub-apps-staging e podem ficar versionados.
#
# PROIBIDO (ADR-0001-D7 + D8) — pertence ao Secret Manager:
#   VITE_JWT_SECRET / VITE_PRIVATE_KEY / VITE_SERVICE_ACCOUNT_KEY
#
# Para o DEPLOY (Portainer) use .env.portainer.example (frontend
# + backend consolidados). Este arquivo é só para dev local.
# ============================================================

# ─── Firebase Web config (projeto hub-apps-staging) ─────────
VITE_FIREBASE_API_KEY=AIzaSyDg04FCrIavT-CmTj670XzDN0YgO9GMuZY
VITE_FIREBASE_AUTH_DOMAIN=hub-apps-staging.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=hub-apps-staging
VITE_FIREBASE_STORAGE_BUCKET=hub-apps-staging.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=128380812490
VITE_FIREBASE_APP_ID=1:128380812490:web:291d06342ab0238ee40833
VITE_FIREBASE_DATABASE_URL=https://hub-apps-staging-default-rtdb.firebaseio.com
VITE_FIREBASE_MEASUREMENT_ID=G-D5QTZF7VJR

# ─── App Check / FCM (opcionais — deixar vazio se não usar) ──
VITE_RECAPTCHA_V3_SITE_KEY=
VITE_FCM_VAPID_KEY=

# ─── hub-api — URL consumida pelo frontend ──────────────────
# Dev local (backend rodando na máquina):  http://localhost:3000
# Apontar p/ backend remoto:                http://186.219.134.246:3010
VITE_API_URL=http://localhost:3000

# ─── Toggle de emulators (true = emulators locais) ──────────
VITE_USE_EMULATOR=false
